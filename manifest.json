{
  "manifest_version": 3,
  "name": "EasySeek — SEEK & LinkedIn Jobs",
  "version": "1.4.1",
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "description": "Local browsing memory, job marks and Markdown tools for SEEK and LinkedIn Jobs.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://nz.seek.com/*",
        "https://seek.co.nz/*",
        "https://www.seek.co.nz/*"
      ],
      "js": [
        "src/state.js",
        "src/seek-extractor.js",
        "src/storage.js",
        "src/jd.js",
        "src/ui.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://nz.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": [
        "src/state.js",
        "src/linkedin-extractor.js",
        "src/storage.js",
        "src/jd.js",
        "src/ui.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
